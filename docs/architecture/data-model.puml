@startuml anthology-data-model
' Anthology – data model (class diagram)
' Concept version: 2026-10-09

title Anthology – Data Model

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #444444
  ArrowColor #555555
}
skinparam package {
  BackgroundColor #F7F7F5
  BorderColor #999999
}
hide empty methods

' =====================================================================
package "Library" {

  class Artist {
    +id : UUID
    +mbArtistId : UUID [0..1]
    +name : String
    +sortName : String
  }
  note right of Artist
    One artist per recording and one
    album artist per release; the credit
    as shown ("A feat. B") is display text.
    Removed when nothing references it.
  end note

  class Recording {
    +id : UUID
    +mbRecordingId : UUID [0..1]
    +isrc : String [0..1]
    +acoustId : UUID [0..1]
    +identificationStatus : IdentificationStatus
    +identificationCheckedAt : DateTime [0..1]
    +identificationNote : String [0..1]
    +title : String
    +artistDisplay : String
    +durationMs : Integer
    +changeSeq : Long
  }

  class AudioFile {
    +id : UUID
    +path : String
    +format : AudioFormat
    +codec : String
    +bitrateKbps : Integer [0..1]
    +sampleRateHz : Integer
    +bitDepth : Integer [0..1]
    +channels : Integer
    +sizeBytes : Long
    +audioHash : String
    +contentHash : String [0..1]
    +storageMode : StorageMode
    +originalStatus : OriginalStatus
    +tagWritesAllowed : Boolean
    +supersededAt : DateTime [0..1]
    +fingerprint : String [0..1]
    +fingerprintDurationS : Integer [0..1]
    +declaredQuality : QualityTier
    +effectiveQuality : QualityTier
    +addedAt : DateTime
  }
  note right of AudioFile
    Exactly one ACTIVE original per recording.
    Album folders only reference it
    (symlink / hardlink / reflink).
    REFERENCED files are written only
    if tagWritesAllowed (opt-in);
    a replaced REFERENCED original
    becomes SUPERSEDED and is kept.
  end note

  class FileLocation {
    +id : UUID
    +path : String
    +kind : LocationKind
    +watched : Boolean
  }

  class QualityAnalysis {
    +id : UUID
    +cutoffHz : Integer [0..1]
    +contentAbove22kHz : Boolean
    +effectiveBitDepth : Integer [0..1]
    +estimatedOrigin : String [0..1]
    +finding : String
    +confidence : Confidence
    +status : AuthenticityStatus
    +spectrogramPath : String [0..1]
    +analyzedAt : DateTime
  }

  class ReleaseGroup {
    +id : UUID
    +mbReleaseGroupId : UUID [0..1]
    +title : String
    +type : ReleaseGroupType
  }

  class Release {
    +id : UUID
    +mbReleaseId : UUID [0..1]
    +title : String
    +albumArtistDisplay : String
    +edition : String [0..1]
    +country : String [0..1]
    +releaseDate : Date [0..1]
    +discCount : Integer
  }

  class Track {
    +id : UUID
    +discNumber : Integer
    +trackNumber : Integer
    +contextTitle : String [0..1]
    +contextArtist : String [0..1]
    +changeSeq : Long
  }
  note bottom of Track
    Context: links a recording to a release.
    Context-specific tags are delivered
    from here, not from the file.
  end note

  class Image {
    +id : UUID
    +contentHash : String
    +mime : String
    +width : Integer
    +height : Integer
    +sizeBytes : Long
    +source : ProvenanceSource
    +blobKey : String
  }
  note right of Image
    Stored once per content hash
    in the BlobStore (ADR 0019);
    thumbnails are cache entries.
  end note

  class ReleaseImage {
    +kind : ImageKind
    +order : Integer
  }

  enum ImageKind {
    FRONT
    BACK
    BOOKLET
    DISC
    OTHER
  }

  class TranscodeCacheEntry {
    +id : UUID
    +kind : CacheKind
    +format : String
    +bitrateKbps : Integer [0..1]
    +contextTrackId : UUID [0..1]
    +blobKey : String
    +sizeBytes : Long
    +changeSeq : Long
    +lastAccessedAt : DateTime
  }

  class ChangeLog {
    +id : Long
    +changeSeq : Long [0..1]
    +entityType : String
    +entityId : UUID
    +operation : ChangeOperation
    +scope : ChangeScope
    +ownerUserId : UUID [0..1]
    +deviceId : UUID [0..1]
    +changedAt : DateTime
  }
  note right of ChangeLog
    One global changeSeq for all data,
    assigned after commit by the sequencer;
    kept for the retention period
    (default 7 days).
  end note

  class ServiceStatus {
    +name : String
    +id : UUID
    +status : ServiceState
    +version : String [0..1]
    +interface : String [0..1]
    +message : String [0..1]
    +changedAt : DateTime
  }
  note right of ServiceStatus
    One row per service (tagger, later
    source services, recognition);
    written on status change only.
  end note

  enum ServiceState {
    AVAILABLE
    UNAVAILABLE
    INCOMPATIBLE
  }

  ServiceStatus --> ServiceState

  enum ChangeScope {
    SHARED
    USER
    DEVICE
  }

  enum AudioFormat {
    FLAC
    WAV
    AIFF
    ALAC
    MP3
    AAC
    OPUS
    VORBIS
  }

  enum QualityTier {
    HIRES_LOSSLESS
    CD_LOSSLESS
    LOSSY_HIGH
    LOSSY_LOW
  }

  enum StorageMode {
    MANAGED
    REFERENCED
  }
  note bottom of StorageMode
    MANAGED: Anthology owns the bytes
    (written, moved, copied or reflinked).
    REFERENCED: foreign location or hardlink.
  end note

  enum CacheKind {
    TRANSCODE
    TAGGED_COPY
  }

  enum IdentificationStatus {
    UNCHECKED
    ISRC
    FINGERPRINT
    NO_MATCH
    DUPLICATE
    NOT_POSSIBLE
  }

  enum OriginalStatus {
    ACTIVE
    SUPERSEDED
  }

  enum LocationKind {
    SYMLINK
    HARDLINK
    REFLINK
    REFERENCED_PATH
  }

  enum ReleaseGroupType {
    ALBUM
    EP
    SINGLE
    COMPILATION
    LIVE
    SOUNDTRACK
    OTHER
  }

  enum AuthenticityStatus {
    GENUINE
    SUSPICIOUS
    UPSCALED
    CONFIRMED_GENUINE
  }

  enum ChangeOperation {
    INSERT
    UPDATE
    DELETE
  }
}

' =====================================================================
package "Sources & Jobs" {

  class Source {
    +id : UUID
    +kind : SourceKind
    +externalId : String [0..1]
    +url : String [0..1]
    +retrievedAt : DateTime
  }

  class Job {
    +id : UUID
    +type : JobType
    +title : String
    +paramsJson : String
    +status : JobStatus
    +priorityClass : PriorityClass
    +parallelItems : Integer
    +progress : Float
    +totalItems : Integer
    +doneItems : Integer
    +failedItems : Integer
    +error : String [0..1]
    +leaseOwner : String [0..1]
    +leaseExpiresAt : DateTime [0..1]
    +createdAt : DateTime
    +startedAt : DateTime [0..1]
    +finishedAt : DateTime [0..1]
  }
  note right of Job
    Runs in at most one process (lease).
    Download options (media mode, max
    video resolution) live in paramsJson.
  end note

  class JobCounter {
    +status : JobStatus
    +count : Integer
  }

  enum PriorityClass {
    INTERACTIVE
    BACKGROUND
  }

  class JobItem {
    +id : UUID
    +position : Integer
    +title : String
    +status : JobStatus
    +progress : Float
    +outcome : ItemOutcome [0..1]
    +message : String [0..1]
    +resultJson : String [0..1]
    +startedAt : DateTime [0..1]
    +finishedAt : DateTime [0..1]
  }

  class CdImportSession {
    +id : UUID
    +discId : String
    +driveName : String
    +driveOffset : Integer
    +targetFormat : AudioFormat
    +accurateRipVerified : Integer
    +ejectWhenDone : Boolean
  }

  class LibraryImport {
    +id : UUID
    +sourceType : ImportSourceType
    +sourcePath : String
    +root : String
    +mode : ImportMode
    +sameMount : Boolean
    +allowTagWrites : Boolean
    +status : ImportStatus
    +reportJson : String [0..1]
    +error : String [0..1]
    +createdAt : DateTime
    +finishedAt : DateTime [0..1]
  }

  class ImportItem {
    +id : UUID
    +path : String
    +sizeBytes : Long
    +mtimeNs : Long
    +audioHash : String [0..1]
    +tagsJson : String [0..1]
    +artistKey : String [0..1]
    +titleKey : String [0..1]
    +groupKey : String [0..1]
    +durationMs : Integer [0..1]
    +isrc : String [0..1]
    +mbRecordingId : UUID [0..1]
    +fingerprint : String [0..1]
    +result : ImportResult [0..1]
    +note : String [0..1]
    +recordingId : UUID [0..1]
    +contentHash : String [0..1]
    +appliedAt : DateTime [0..1]
    +failed : Boolean
  }

  enum SourceKind {
    TIDAL
    SPOTIFY
    YOUTUBE
    CD
    LIBRARY_IMPORT
    UPLOAD
  }

  enum JobType {
    DEMO
    DOWNLOAD
    CD_IMPORT
    LIBRARY_IMPORT
    TAGGING
    LIBRARY_SCAN
    DUPLICATE_SCAN
    QUALITY_ANALYSIS
    PUBLISHER_SEARCH
    REVIEW_BULK
    TAGGING_BULK
    METADATA_REFRESH
    IDENTIFY_RECORDINGS
    OMR
    TRANSCODE
  }

  enum JobStatus {
    QUEUED
    RUNNING
    PAUSED
    DONE
    FAILED
    CANCELLED
  }

  enum MediaMode {
    AUDIO_ONLY
    VIDEO
  }

  enum ImportSourceType {
    FOLDER_SERVER
    FOLDER_CLIENT
    ITUNES
    MEDIA_SERVER
    BEETS
    PLAYLIST_FILE
  }

  enum ImportMode {
    REFERENCE
    MOVE
    REFLINK
    HARDLINK
    COPY
  }

  enum ImportStatus {
    SCANNING
    REPORTED
    IMPORTING
    DONE
    CANCELLED
    FAILED
  }

  enum ThrottleLevel {
    GENTLE
    NORMAL
    FAST
  }

  enum ItemOutcome {
    NEW
    REPLACED
    ALREADY_PRESENT
    NOT_BETTER_THAN_EXISTING
    NEEDS_REVIEW
    FAILED
  }

  enum ImportResult {
    NEW
    ALREADY_PRESENT
    REPLACES_LOWER_QUALITY
    DUPLICATE_IN_SOURCE
    NEEDS_REVIEW
    BROKEN
    SKIPPED
  }
}

' =====================================================================
package "Users & Devices" {

  class User {
    +id : UUID
    +username : String
    +displayName : String
    +passwordHash : String [0..1]
    +role : Role
    +origin : AccountOrigin
    +active : Boolean
    +createdAt : DateTime
  }
  note right of User
    One account per person, no profiles;
    passwordHash empty for OIDC accounts.
  end note

  enum AccountOrigin {
    LOCAL
    OIDC
  }

  class UserSettings {
    +language : String
    +theme : Theme
  }

  class Device {
    +id : UUID
    +name : String
    +type : DeviceType
    +platform : String
    +supportedFormats : Set<AudioFormat>
    +lastSeenAt : DateTime
  }

  class UserDevice {
    +id : UUID
    +refreshTokenHash : String
    +signedInAt : DateTime
    +lastUsedAt : DateTime [0..1]
    +revokedAt : DateTime [0..1]
  }

  class UserDeviceSettings {
    +audioBitrate : BitrateSetting
    +offlineBitrate : BitrateSetting [0..1]
    +maxVideoResolution : Integer
    +offlineLimitBytes : Long [0..1]
    +wifiOnlySync : Boolean
    +videosWifiOnly : Boolean
    +defaultOutput : String [0..1]
    +viewPrefsJson : String
  }

  class OfflineCopy {
    +id : UUID
    +variant : String
    +sizeBytes : Long
    +changeSeq : Long
    +syncedAt : DateTime
  }

  class OfflineSelection {
    +targetType : OfflineTarget
    +targetId : UUID
    +createdAt : DateTime
  }

  enum OfflineTarget {
    RELEASE
    PLAYLIST
  }

  class Playlist {
    +id : UUID
    +name : String
    +visibility : PlaylistVisibility
  }

  class PlaylistFolder {
    +id : UUID
    +name : String
  }

  enum PlaylistVisibility {
    PRIVATE
    SHARED_ALL
  }

  class PlaylistEntry {
    +id : UUID
    +positionKey : String
    +addedAt : DateTime
  }
  note right of PlaylistEntry
    Fractional position key;
    ties broken by id.
  end note

  class Favorite {
    +targetType : FavoriteTarget
    +targetId : UUID
    +createdAt : DateTime
  }

  enum FavoriteTarget {
    RECORDING
    RELEASE
    ARTIST
    WORK
  }

  class PlayHistory {
    +playedAt : DateTime
    +durationPlayedMs : Integer
  }
  note right of PlayHistory
    Recorded after 50 % or 4 minutes.
  end note

  class PlayStats {
    +playCount : Integer
    +importedCount : Integer
    +lastPlayedAt : DateTime [0..1]
  }

  class AuditLog {
    +id : UUID
    +entityType : String
    +entityId : UUID
    +action : String
    +diffJson : String
    +changeSetId : UUID [0..1]
    +userId : UUID [0..1]
    +at : DateTime
  }

  class LookupCache {
    +service : String
    +requestKey : String
    +responseJson : String
    +fetchedAt : DateTime
    +expiresAt : DateTime
  }

  class LookupSchedule {
    +target : String
    +nextSlotAt : DateTime
  }
  note right of LookupSchedule
    Next free request slot per
    rate-limited service, shared by
    all server processes.
  end note

  class ExternalRef {
    +entityType : String
    +entityId : UUID
    +mbid : UUID
    +lastCheckedAt : DateTime [0..1]
  }
  note right of ExternalRef
    Drives the periodic
    MusicBrainz refresh.
  end note

  class ChangeSet {
    +id : UUID
    +ruleJson : String [0..1]
    +createdAt : DateTime
    +undoneAt : DateTime [0..1]
  }
  note right of ChangeSet
    One edit operation (single or bulk);
    undo writes old values from AuditLog.
  end note

  class FieldProvenance {
    +entityType : String
    +entityId : UUID
    +field : String
    +source : ProvenanceSource
    +setAt : DateTime
  }

  enum ProvenanceSource {
    MANUAL
    MUSICBRAINZ
    IMPORT
    SOURCE
    PUBLISHER
    REVIEW
  }

  enum Role {
    ADMIN
    EDITOR
    LISTENER
  }

  enum DeviceType {
    WEB
    DESKTOP
    MOBILE
  }

  enum BitrateSetting {
    ORIGINAL
    KBPS_320
    KBPS_256
    KBPS_192
    KBPS_128
  }

  enum Theme {
    SYSTEM
    DARK
    LIGHT
  }
}

' =====================================================================
package "Playback" {

  class OutputDevice {
    +id : UUID
    +adapter : OutputAdapter
    +name : String
    +address : String
    +supportedFormats : Set<AudioFormat>
    +online : Boolean
  }

  class OutputZone {
    +id : UUID
    +name : String
  }

  enum OutputAdapter {
    CLIENT
    RAUMFELD
    UPNP
    SONOS
    CHROMECAST
  }
}

' =====================================================================
package "Works & Publishers" {

  class Work {
    +id : UUID
    +title : String
    +type : WorkType
    +composers : String
    +arrangers : String [0..1]
    +instrumentation : String [0..1]
    +grade : String [0..1]
    +durationSec : Integer [0..1]
    +mbWorkId : UUID [0..1]
    +iswc : String [0..1]
  }

  class WorkRelation {
    +type : WorkRelationType
    +position : Integer [0..1]
    +sectionStart : String [0..1]
    +sectionEnd : String [0..1]
    +origin : String
    +confidence : Confidence
  }

  class RecordingWork {
    +confirmed : Boolean
  }

  class Publisher {
    +id : UUID
    +name : String
    +country : String [0..1]
    +website : String [0..1]
    +adapterType : PublisherAdapterType
    +adapterConfigJson : String
    +profileRef : String [0..1]
    +active : Boolean
    +rateLimitPerMin : Integer
    +lastQueriedAt : DateTime [0..1]
  }

  class Publication {
    +id : UUID
    +orderNumber : String [0..1]
    +ismn : String [0..1]
    +title : String
    +instrumentation : String [0..1]
    +grade : String [0..1]
    +durationSec : Integer [0..1]
    +productUrl : String [0..1]
    +fetchedAt : DateTime
  }

  enum WorkType {
    ORIGINAL
    ARRANGEMENT
    MEDLEY
    ADAPTATION
  }

  enum WorkRelationType {
    ARRANGEMENT_OF
    MEDLEY_CONTAINS
    PART_OF
  }

  enum PublisherAdapterType {
    STRUCTURED_DATA
    HTML_SELECTORS
    PLUGIN
    LLM
    CSV_IMPORT
  }

  enum Confidence {
    HIGH
    MEDIUM
    LOW
  }

  enum ReviewStatus {
    OPEN
    ACCEPTED
    REJECTED
    DEFERRED
    OBSOLETE
    AUTO_ACCEPTED
  }
  note bottom of ReviewStatus
    AUTO_ACCEPTED only for Sheet.reviewStatus;
    automatic decisions create no ReviewItem.
  end note
}

' =====================================================================
package "Review" {

  class ReviewItem {
    +id : UUID
    +type : ReviewType
    +subjectType : String
    +subjectId : UUID
    +origin : ReviewOrigin
    +confidence : Confidence
    +evidenceJson : String
    +proposalJson : String
    +suppressionKey : String
    +status : ReviewStatus
    +createdAt : DateTime
    +decidedAt : DateTime [0..1]
    +changeSeq : Long
  }
  note right of ReviewItem
    Also holds work candidates.
    Unique suppressionKey while
    OPEN, DEFERRED or REJECTED.
  end note

  enum ReviewType {
    RECORDING_MATCH
    QUALITY_FINDING
    WORK_ASSIGNMENT
    DOWNLOAD_REPLACEMENT
    TAG_CONFLICT
    SHEET_OMR
  }

  enum ReviewOrigin {
    PUBLISHER
    MUSICBRAINZ
    LLM
    FUZZY_MATCH
    QUALITY_ANALYSIS
    IMPORT
    SOURCE
    OMR
  }
}

' =====================================================================
package "Sheet Music" {

  class Sheet {
    +id : UUID
    +type : SheetType
    +instrument : String
    +voice : String [0..1]
    +transposition : Transposition
    +clef : String [0..1]
    +recognitionStatus : RecognitionStatus
    +reviewStatus : ReviewStatus
    +displayMode : DisplayMode
  }
  note right of Sheet
    SCORE  -> page mode
    PART   -> line (system) mode
    Keyboard / accordion parts:
    one system = all braced staves
  end note

  class SheetFile {
    +id : UUID
    +kind : SheetFileKind
    +path : String
    +version : Integer
  }

  class SheetPage {
    +id : UUID
    +pageNumber : Integer
    +width : Float
    +height : Float
    +previewPath : String
  }

  class SheetSystem {
    +id : UUID
    +index : Integer
    +bbox : Rect
    +staffCount : Integer
  }

  class MeasureMapEntry {
    +measureNumber : Integer
    +bbox : Rect
    +startMs : Integer
    +endMs : Integer
    +recognitionConfidence : Float [0..1]
  }

  class SheetAnnotation {
    +id : UUID
    +measureNumber : Integer
    +dataJson : String
  }

  enum SheetType {
    SCORE
    PART
  }

  enum DisplayMode {
    AUTO
    PAGE
    SYSTEM
  }

  enum Transposition {
    C
    B_FLAT
    E_FLAT
    F
    OTHER
  }

  enum SheetFileKind {
    PDF
    IMAGE
    MUSICXML
    MEI
    MIDI
  }

  enum RecognitionStatus {
    NOT_NEEDED
    PENDING
    RUNNING
    RECOGNIZED
    FAILED
  }
}

' =====================================================================
package "Video" {

  class VideoFile {
    +id : UUID
    +path : String
    +container : String
    +videoCodec : String
    +audioCodec : String
    +width : Integer
    +height : Integer
    +durationMs : Integer
    +sizeBytes : Long
    +contentHash : String
    +sourceItemId : String [0..1]
    +thumbnailPath : String
  }
  note right of VideoFile
    Separate media type: its audio is
    never an audio original.
  end note

  class VideoRendition {
    +id : UUID
    +height : Integer
    +bitrateKbps : Integer
    +hlsPath : String
    +lastAccessedAt : DateTime
  }

  class VideoChapter {
    +id : UUID
    +title : String
    +startMs : Integer
    +endMs : Integer
  }
}

' =====================================================================
' Relationships – Library
Recording "1" -- "0..*" AudioFile : originals (at most one ACTIVE) >
AudioFile "1" -- "0..*" FileLocation : located at >
AudioFile "0..*" -- "0..1" AudioFile : superseded by >
Recording "0..*" -- "0..1" Recording : duplicate of (identification) >
AudioFile "0..*" -- "0..1" Track : home context (imported with) >
AudioFile "1" -- "0..1" QualityAnalysis : analysed by >
AudioFile "1" -- "0..*" TranscodeCacheEntry : variants >
AudioFile "0..*" -- "1" Source : retrieved from >
ReleaseGroup "1" *-- "1..*" Release
Release "1" *-- "1..*" Track
Track "0..*" -- "1" Recording : plays >
Recording "0..*" -- "1" Artist : artist >
Release "0..*" -- "1" Artist : album artist >
Release "0..*" -- "0..1" Image : front cover >
Recording "0..*" -- "0..1" Image : own front cover >
Release "1" *-- "0..*" ReleaseImage : gallery >
ReleaseImage "0..*" -- "1" Image

' Relationships – Jobs & Import
Job "1" *-- "0..*" JobItem
Job "0..*" -- "1" User : created by >
JobItem "0..*" -- "0..1" Recording : produced >
Job "1" -- "0..1" CdImportSession
Job "1" -- "0..1" LibraryImport
LibraryImport "1" *-- "0..*" ImportItem
LibraryImport "0..*" -- "1" User : created by >
ImportItem "0..*" -- "0..1" AudioFile : created >
ImportItem "0..*" -- "0..1" Recording : matched >
ImportItem "0..*" -- "0..1" ImportItem : duplicate of >
ImportItem "0..*" -- "0..1" Release : grouped into >
CdImportSession "0..*" -- "1" Device : ripped on >

' Relationships – Users & Devices
User "1" *-- "1" UserSettings
User "1" *-- "0..*" UserDevice
Device "1" *-- "0..*" UserDevice
UserDevice "1" *-- "1" UserDeviceSettings
UserDeviceSettings "0..*" -- "0..1" OutputDevice : default output >
UserDevice "1" *-- "0..*" OfflineCopy
UserDevice "1" *-- "0..*" OfflineSelection
OfflineCopy "0..*" -- "1" Recording
User "1" *-- "0..*" Playlist
Playlist "1" *-- "0..*" PlaylistEntry
PlaylistEntry "0..*" -- "1" Track : context >
PlaylistEntry "0..*" -- "1" User : added by >
User "1" *-- "0..*" PlaylistFolder
PlaylistFolder "0..1" o-- "0..*" Playlist
User "1" -- "0..*" Favorite
User "1" -- "0..*" PlayHistory
PlayHistory "0..*" -- "1" Track
PlayHistory "0..*" -- "1" Device
User "1" -- "0..*" PlayStats
PlayStats "0..*" -- "1" Recording
AuditLog "0..*" -- "1" User : by >

' Relationships – Playback
OutputZone "0..1" o-- "1..*" OutputDevice

' Relationships – Works & Publishers
Work "1" -- "0..*" WorkRelation : source >
WorkRelation "0..*" -- "1" Work : target >
Recording "1" -- "0..*" RecordingWork
RecordingWork "0..*" -- "1" Work
Publisher "1" *-- "0..*" Publication
Publication "0..*" -- "1" Work : edition of >
ReviewItem "0..*" -- "0..1" User : decided by >
ReviewItem "0..*" -- "0..1" Job : bulk decision >

' Relationships – Sheet Music
Work "1" *-- "0..*" Sheet
Sheet "0..*" -- "0..1" Publication : from >
Sheet "1" *-- "1..*" SheetFile
Sheet "1" *-- "0..*" SheetPage
SheetPage "1" *-- "0..*" SheetSystem
