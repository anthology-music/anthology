@startuml anthology-data-model
' Anthology – data model (class diagram)
' Concept version: 2026-10-09

title Anthology – Data Model

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #444444
  ArrowColor #555555
}
skinparam package {
  BackgroundColor #F7F7F5
  BorderColor #999999
}
hide empty methods

' =====================================================================
package "Library" {

  class Artist {
    +id : UUID
    +mbArtistId : UUID [0..1]
    +name : String
    +sortName : String
  }
  note right of Artist
    One artist per recording and one
    album artist per release; the credit
    as shown ("A feat. B") is display text.
    Removed when nothing references it.
  end note

  class Recording {
    +id : UUID
    +mbRecordingId : UUID [0..1]
    +isrc : String [0..1]
    +acoustId : UUID [0..1]
    +identificationStatus : IdentificationStatus
    +identificationCheckedAt : DateTime [0..1]
    +identificationNote : String [0..1]
    +title : String
    +artistDisplay : String
    +durationMs : Integer
    +composers : String[]
    +genres : String[]
    +changeSeq : Long
  }

  class AudioFile {
    +id : UUID
    +path : String
    +format : AudioFormat
    +codec : String
    +bitrateKbps : Integer [0..1]
    +sampleRateHz : Integer
    +bitDepth : Integer [0..1]
    +channels : Integer
    +sizeBytes : Long
    +audioHash : String
    +contentHash : String [0..1]
    +storageMode : StorageMode
    +originalStatus : OriginalStatus
    +tagWritesAllowed : Boolean
    +supersededAt : DateTime [0..1]
    +fingerprint : String [0..1]
    +fingerprintDurationS : Integer [0..1]
    +declaredQuality : QualityTier
    +effectiveQuality : QualityTier [0..1]
    +qualityStatus : AuthenticityStatus [0..1]
    +addedAt : DateTime
  }
  note right of AudioFile
    Exactly one ACTIVE original per recording.
    Album folders only reference it
    (symlink / hardlink / reflink).
    REFERENCED files are written only
    if tagWritesAllowed (opt-in);
    a replaced REFERENCED original
    becomes SUPERSEDED and is kept;
    a replaced MANAGED original is deleted
    after verification or kept SUPERSEDED
    (per run, ADR 0021).
  end note

  class FileLocation {
    +id : UUID
    +path : String
    +kind : LocationKind
    +watched : Boolean
  }

  class QualityAnalysis {
    +audioHash : String
    +status : AuthenticityStatus
    +confidence : Confidence
    +finding : String
    +findingValues : String
    +effectiveQuality : QualityTier [0..1]
    +cutoffHz : Integer [0..1]
    +effectiveSampleRateHz : Integer [0..1]
    +effectiveBitDepth : Integer [0..1]
    +estimatedBitrateKbps : Integer [0..1]
    +wholeFile : Boolean
    +methodVersion : Integer
    +analyzedAt : DateTime
    +decidedStatus : AuthenticityStatus [0..1]
    +decidedQuality : QualityTier [0..1]
    +decidedAt : DateTime [0..1]
  }
  note right of QualityAnalysis
    One result per audio hash: files
    with equal audio share it.
    Only HIGH confidence or a human
    decision (review list) sets
    AudioFile.effectiveQuality; the
    decision survives re-analysis.
    Spectrograms are rendered on
    demand and cached by audio hash.
  end note

  class ReleaseGroup {
    +id : UUID
    +mbReleaseGroupId : UUID [0..1]
    +title : String
    +type : ReleaseGroupType
  }

  class Release {
    +id : UUID
    +mbReleaseId : UUID [0..1]
    +title : String
    +albumArtistDisplay : String
    +edition : String [0..1]
    +country : String [0..1]
    +releaseDate : Date [0..1]
    +label : String [0..1]
    +discCount : Integer
  }

  class Track {
    +id : UUID
    +discNumber : Integer
    +trackNumber : Integer
    +contextTitle : String [0..1]
    +contextArtist : String [0..1]
    +changeSeq : Long
  }
  note bottom of Track
    Context: links a recording to a release.
    Context-specific tags are delivered
    from here, not from the file.
  end note

  class Image {
    +id : UUID
    +contentHash : String
    +mime : String
    +width : Integer
    +height : Integer
    +sizeBytes : Long
    +source : ProvenanceSource
    +blobKey : String
  }
  note right of Image
    Stored once per content hash
    in the BlobStore (ADR 0019);
    thumbnails are cache entries.
  end note

  class ReleaseImage {
    +kind : ImageKind
    +order : Integer
  }

  enum ImageKind {
    FRONT
    BACK
    BOOKLET
    DISC
    OTHER
  }

  class TranscodeCacheEntry {
    One per variant (variantKey unique):
    a transcode of an original, or its copy
    tagged for one context track
    ==
    +id : UUID
    +variantKey : String
    +kind : CacheKind
    +format : String
    +bitrateKbps : Integer [0..1]
    +contextTrackId : UUID [0..1]
    +status : CacheStatus
    +path : String
    +sizeBytes : Long
    +createdAt : DateTime
    +lastAccessedAt : DateTime
  }

  enum CacheStatus {
    RUNNING
    READY
    FAILED
  }

  class ChangeLog {
    +id : Long
    +changeSeq : Long [0..1]
    +entityType : String
    +entityId : UUID
    +operation : ChangeOperation
    +scope : ChangeScope
    +ownerUserId : UUID [0..1]
    +deviceId : UUID [0..1]
    +changedAt : DateTime
  }
  note right of ChangeLog
    One global changeSeq for all data,
    assigned after commit by the sequencer;
    kept for the retention period
    (default 7 days).
  end note

  class ServiceStatus {
    +name : String
    +id : UUID
    +status : ServiceState
    +version : String [0..1]
    +interface : String [0..1]
    +message : String [0..1]
    +changedAt : DateTime
  }
  note right of ServiceStatus
    One row per service (tagger, later
    source services, recognition);
    written on status change only.
  end note

  enum ServiceState {
    AVAILABLE
    UNAVAILABLE
    INCOMPATIBLE
  }

  ServiceStatus --> ServiceState

  class MaintenanceRun {
    +id : UUID
    +trigger : MaintenanceTrigger
    +status : MaintenanceStatus
    +action : MaintenanceAction
    +graceHours : Integer
    +safetySharePercent : Float [0..1]
    +safetyLimit : Integer [0..1]
    +managedFiles : Long
    +startedAt : DateTime
    +finishedAt : DateTime [0..1]
    +error : String [0..1]
    +orphanFiles / orphanBytes : Long
    +leftoverFiles / leftoverBytes : Long
    +missingFiles / missingBytes : Long
    +deletedFiles / deletedBytes : Long
    +listedFiles / listedBytes : Long
  }
  note right of MaintenanceRun
    One run of the library maintenance
    (UC-001). safetyLimit = max(10, share
    of managedFiles); a run over it is HELD
    until an admin confirms. The newest
    runs are kept.
  end note

  enum MaintenanceStatus {
    RUNNING
    DONE
    HELD
    REPORTED
    FAILED
  }

  enum MaintenanceAction {
    DELETE
    REPORT
  }

  class MaintenanceFinding {
    +id : UUID
    +path : String
    +kind : FindingKind
    +sizeBytes : Long
    +modifiedAt : DateTime [0..1]
    +outcome : FindingOutcome [0..1]
    +detail : String [0..1]
  }
  note right of MaintenanceFinding
    Unique per (run, path). Orphans and
    leftovers lie in _originals only; missing
    entries are only listed, never changed.
  end note

  enum FindingKind {
    ORPHAN
    LEFTOVER
    MISSING
  }

  enum FindingOutcome {
    DELETED
    LISTED
    REFERENCED
    TOO_YOUNG
    OUTSIDE
    GONE
    FAILED
  }

  MaintenanceRun --> MaintenanceStatus
  MaintenanceRun --> MaintenanceAction
  MaintenanceFinding --> FindingKind
  MaintenanceFinding --> FindingOutcome

  enum ChangeScope {
    SHARED
    USER
    DEVICE
  }

  enum AudioFormat {
    FLAC
    WAV
    AIFF
    ALAC
    MP3
    AAC
    OPUS
    VORBIS
  }

  enum QualityTier {
    HIRES_LOSSLESS
    CD_LOSSLESS
    LOSSY_HIGH
    LOSSY_LOW
  }

  enum StorageMode {
    MANAGED
    REFERENCED
  }
  note bottom of StorageMode
    MANAGED: Anthology owns the bytes
    (written, moved, copied or reflinked).
    REFERENCED: foreign location or hardlink.
  end note

  enum CacheKind {
    TRANSCODE
    TAGGED_COPY
  }

  enum IdentificationStatus {
    UNCHECKED
    ISRC
    FINGERPRINT
    NO_MATCH
    DUPLICATE
    NOT_POSSIBLE
    CONFIRMED
  }

  enum OriginalStatus {
    ACTIVE
    SUPERSEDED
  }

  enum LocationKind {
    SYMLINK
    HARDLINK
    REFLINK
    REFERENCED_PATH
  }

  enum ReleaseGroupType {
    ALBUM
    EP
    SINGLE
    COMPILATION
    LIVE
    SOUNDTRACK
    OTHER
  }

  enum AuthenticityStatus {
    GENUINE
    SUSPICIOUS
    UPSCALED
    CONFIRMED_GENUINE
  }

  enum ChangeOperation {
    INSERT
    UPDATE
    DELETE
  }
}

' =====================================================================
package "Sources & Jobs" {

  class Source {
    Where an original was acquired;
    kind is the service's source id
    (e.g. "tidal"), not a fixed list
    ==
    +id : UUID
    +kind : String
    +label : String
    +short : String [0..1]
    +externalId : String [0..1]
    +url : String [0..1]
    +retrievedAt : DateTime
  }

  class DownloadOrder {
    Tracks ordered from one source service;
    imported by a self-confirming library import
    ==
    +id : UUID
    +serviceUrl : String
    +serviceName : String
    +source : String
    +title : String
    +quality : String
    +status : OrderStatus
    +folder : String
    +taskId : String [0..1]
    +createdAt : DateTime
    +finishedAt : DateTime [0..1]
  }

  class DownloadOrderItem {
    +id : UUID
    +position : Integer
    +ref : String
    +title : String
    +duplicate : String
    +state : OrderItemState
    +progress : Float
    +file : String [0..1]
    +outcome : ItemOutcome [0..1]
  }

  enum OrderStatus {
    DOWNLOADING
    IMPORTING
    DONE
    FAILED
  }

  enum OrderItemState {
    QUEUED
    RUNNING
    WAITING
    DOWNLOADED
    DONE
    SKIPPED
    FAILED
  }

  class SourceService {
    One configured service URL
    (ANTHOLOGY_SOURCE_SERVICES), checked
    with info and health (ADR 0017)
    ==
    +id : UUID
    +url : String
    +position : Integer
    +serviceId : String [0..1]
    +name : String [0..1]
    +source : String [0..1]
    +short : String [0..1]
    +interface : Integer [0..1]
    +version : String [0..1]
    +capabilities : Json
    +loginFields : Json [0..1]
    +available : Boolean
    +loggedIn : Boolean [0..1]
    +rateLimitedUntil : DateTime [0..1]
    +problem : SourceProblem [0..1]
    +checkedAt : DateTime
  }

  class SourceCredential {
    Login fields of a service,
    encrypted with AES-GCM
    ==
    +serviceId : String
    +nonce : Bytes
    +ciphertext : Bytes
    +updatedAt : DateTime
  }

  enum SourceProblem {
    UNREACHABLE
    INCOMPATIBLE
    LOGIN_FAILED
    LOGIN_MISSING
  }

  class Job {
    +id : UUID
    +type : JobType
    +title : String
    +paramsJson : String
    +status : JobStatus
    +priorityClass : PriorityClass
    +parallelItems : Integer
    +progress : Float
    +totalItems : Integer
    +doneItems : Integer
    +failedItems : Integer
    +error : String [0..1]
    +leaseOwner : String [0..1]
    +leaseExpiresAt : DateTime [0..1]
    +createdAt : DateTime
    +startedAt : DateTime [0..1]
    +finishedAt : DateTime [0..1]
  }
  note right of Job
    Runs in at most one process (lease).
    Download options (media mode, max
    video resolution) live in paramsJson.
  end note

  class JobSchedule {
    +type : JobType
    +enabled : Boolean
    +frequency : ScheduleFrequency
    +timeOfDay : Time
    +weekday : Integer [0..1]
    +optionsJson : String
    +nextRunAt : DateTime [0..1]
    +updatedAt : DateTime [0..1]
  }
  note right of JobSchedule
    One row per recurring job type (first:
    library_maintenance). Local times in
    ANTHOLOGY_TIME_ZONE; nextRunAt (UTC) is
    claimed by compare-and-swap, so one
    process creates the job.
  end note

  enum ScheduleFrequency {
    DAILY
    WEEKLY
  }

  JobSchedule --> ScheduleFrequency

  class JobCounter {
    +status : JobStatus
    +count : Integer
  }

  enum PriorityClass {
    INTERACTIVE
    BACKGROUND
  }

  class JobItem {
    +id : UUID
    +position : Integer
    +title : String
    +status : JobStatus
    +progress : Float
    +outcome : ItemOutcome [0..1]
    +message : String [0..1]
    +resultJson : String [0..1]
    +startedAt : DateTime [0..1]
    +finishedAt : DateTime [0..1]
  }

  class CdImportSession {
    +id : UUID
    +discId : String
    +driveName : String
    +driveOffset : Integer
    +targetFormat : AudioFormat
    +accurateRipVerified : Integer
    +ejectWhenDone : Boolean
  }

  class LibraryImport {
    +id : UUID
    +sourceType : ImportSourceType
    +sourcePath : String
    +root : String
    +mode : ImportMode
    +sameMount : Boolean
    +allowTagWrites : Boolean
    +deleteReplaced : Boolean
    +status : ImportStatus
    +reportJson : String [0..1]
    +error : String [0..1]
    +createdAt : DateTime
    +finishedAt : DateTime [0..1]
  }

  class ImportItem {
    +id : UUID
    +path : String
    +sizeBytes : Long
    +mtimeNs : Long
    +audioHash : String [0..1]
    +tagsJson : String [0..1]
    +artistKey : String [0..1]
    +titleKey : String [0..1]
    +groupKey : String [0..1]
    +durationMs : Integer [0..1]
    +isrc : String [0..1]
    +mbRecordingId : UUID [0..1]
    +fingerprint : String [0..1]
    +result : ImportResult [0..1]
    +note : String [0..1]
    +nameMatchSimilarity : Float [0..1]
    +recordingId : UUID [0..1]
    +contentHash : String [0..1]
    +appliedAt : DateTime [0..1]
    +failed : Boolean
  }

  enum SourceKind {
    TIDAL
    SPOTIFY
    YOUTUBE
    CD
    LIBRARY_IMPORT
    UPLOAD
  }

  enum JobType {
    DEMO
    DOWNLOAD
    CD_IMPORT
    LIBRARY_IMPORT
    TAGGING
    LIBRARY_SCAN
    DUPLICATE_SCAN
    QUALITY_ANALYSIS
    PUBLISHER_SEARCH
    REVIEW_BULK
    TAGGING_BULK
    TAGGING_UNDO
    METADATA_REFRESH
    IDENTIFY_RECORDINGS
    OMR
    TRANSCODE
  }

  enum JobStatus {
    QUEUED
    RUNNING
    PAUSED
    DONE
    FAILED
    CANCELLED
  }

  enum MediaMode {
    AUDIO_ONLY
    VIDEO
  }

  enum ImportSourceType {
    FOLDER_SERVER
    FOLDER_CLIENT
    ITUNES
    MEDIA_SERVER
    BEETS
    PLAYLIST_FILE
  }

  enum ImportMode {
    REFERENCE
    MOVE
    REFLINK
    HARDLINK
    COPY
  }

  enum ImportStatus {
    SCANNING
    REPORTED
    IMPORTING
    DONE
    CANCELLED
    FAILED
  }

  enum ThrottleLevel {
    GENTLE
    NORMAL
    FAST
  }

  enum ItemOutcome {
    NEW
    REPLACED
    ALREADY_PRESENT
    NOT_BETTER_THAN_EXISTING
    NEEDS_REVIEW
    FAILED
  }

  enum ImportResult {
    NEW
    ALREADY_PRESENT
    REPLACES_LOWER_QUALITY
    DUPLICATE_IN_SOURCE
    NEEDS_REVIEW
    BROKEN
    SKIPPED
    SUSPICIOUS_QUALITY
  }
}

' =====================================================================
package "Users & Devices" {

  class User {
    +id : UUID
    +username : String
    +displayName : String
    +passwordHash : String [0..1]
    +role : Role
    +origin : AccountOrigin
    +active : Boolean
    +createdAt : DateTime
  }
  note right of User
    One account per person, no profiles;
    passwordHash empty for OIDC accounts.
  end note

  enum AccountOrigin {
    LOCAL
    OIDC
  }

  class UserSettings {
    +language : String
    +theme : Theme
  }

  class Device {
    +id : UUID
    +name : String
    +type : DeviceType
    +platform : String
    +supportedFormats : Set<AudioFormat>
    +lastSeenAt : DateTime
  }

  class UserDevice {
    +id : UUID
    +refreshTokenHash : String
    +signedInAt : DateTime
    +lastUsedAt : DateTime [0..1]
    +revokedAt : DateTime [0..1]
  }

  class UserDeviceSettings {
    +audioBitrate : BitrateSetting
    +offlineBitrate : BitrateSetting [0..1]
    +maxVideoResolution : Integer
    +offlineLimitBytes : Long [0..1]
    +wifiOnlySync : Boolean
    +videosWifiOnly : Boolean
    +defaultOutput : String [0..1]
    +viewPrefsJson : String
  }

  class OfflineCopy {
    +id : UUID
    +variant : String
    +sizeBytes : Long
    +changeSeq : Long
    +syncedAt : DateTime
  }

  class OfflineSelection {
    +targetType : OfflineTarget
    +targetId : UUID
    +createdAt : DateTime
  }

  enum OfflineTarget {
    RELEASE
    PLAYLIST
  }

  class Playlist {
    +id : UUID
    +name : String
    +visibility : PlaylistVisibility
  }

  class PlaylistFolder {
    +id : UUID
    +name : String
  }

  enum PlaylistVisibility {
    PRIVATE
    SHARED_ALL
  }

  class PlaylistEntry {
    +id : UUID
    +positionKey : String
    +addedAt : DateTime
  }
  note right of PlaylistEntry
    Fractional position key;
    ties broken by id.
  end note

  class Favorite {
    +targetType : FavoriteTarget
    +targetId : UUID
    +createdAt : DateTime
  }

  enum FavoriteTarget {
    RECORDING
    RELEASE
    ARTIST
    WORK
  }

  class PlayHistory {
    +playedAt : DateTime
    +durationPlayedMs : Integer
  }
  note right of PlayHistory
    Recorded after 50 % or 4 minutes.
  end note

  class PlayStats {
    +playCount : Integer
    +importedCount : Integer
    +lastPlayedAt : DateTime [0..1]
  }

  class AuditLog {
    +id : UUID
    +entityType : String
    +entityId : UUID
    +action : String
    +diffJson : String
    +changeSetId : UUID [0..1]
    +userId : UUID [0..1]
    +at : DateTime
  }

  class LookupCache {
    +service : String
    +requestKey : String
    +responseJson : String
    +fetchedAt : DateTime
    +expiresAt : DateTime
  }

  class LookupSchedule {
    +target : String
    +nextSlotAt : DateTime
  }
  note right of LookupSchedule
    Next free request slot per
    rate-limited service, shared by
    all server processes.
  end note

  class ExternalRef {
    +entityType : String
    +entityId : UUID
    +mbid : UUID
    +lastCheckedAt : DateTime [0..1]
  }
  note right of ExternalRef
    Drives the periodic
    MusicBrainz refresh.
  end note

  class ChangeSet {
    +id : UUID
    +kind : ChangeSetKind
    +summaryJson : String
    +ruleJson : String [0..1]
    +items : Integer
    +createdAt : DateTime
  }
  note right of ChangeSet
    One edit operation (single or bulk);
    undo writes old values from AuditLog
    (rows with changeSetId) and is a
    change set itself.
  end note

  enum ChangeSetKind {
    EDIT
    UNDO
  }

  class FieldProvenance {
    +entityType : String
    +entityId : UUID
    +field : String
    +source : ProvenanceSource
    +setAt : DateTime
  }
  note right of FieldProvenance
    Only for values set after the import:
    a value without a row counts as IMPORT.
  end note

  class TagWrite {
    +audioFileId : UUID
    +requestedAt : DateTime
    +attempts : Integer
    +lastError : String [0..1]
    +claimedUntil : DateTime [0..1]
  }
  note right of TagWrite
    Queue of pending file writes, one
    row per file (coalescing); tags are
    built from the database at write time.
  end note

  enum ProvenanceSource {
    MANUAL
    MUSICBRAINZ
    IMPORT
    SOURCE
    PUBLISHER
    REVIEW
  }

  enum Role {
    ADMIN
    EDITOR
    LISTENER
  }

  enum DeviceType {
    WEB
    DESKTOP
    MOBILE
  }

  enum BitrateSetting {
    ORIGINAL
    KBPS_320
    KBPS_256
    KBPS_192
    KBPS_128
  }

  enum Theme {
    SYSTEM
    DARK
    LIGHT
  }
}

' =====================================================================
package "Playback" {

  class OutputDevice {
    +id : UUID
    +adapter : OutputAdapter
    +name : String
    +address : String
    +supportedFormats : Set<AudioFormat>
    +online : Boolean
  }

  class OutputZone {
    +id : UUID
    +name : String
  }

  class PlayQueue {
    Queue of one user on one device
    (change local-playback); rewriting all
    entries changes the generation
    ==
    +id : UUID
    +generation : UUID
    +currentEntryId : Long [0..1]
    +positionMs : Integer
    +playing : Boolean
    +shortened : Boolean
    +updatedAt : DateTime
  }

  class PlayQueueEntry {
    At most 10,000 per queue
    ==
    +id : Long
    +position : Long
  }

  enum OutputAdapter {
    CLIENT
    RAUMFELD
    UPNP
    SONOS
    CHROMECAST
  }
}

' =====================================================================
package "Works & Publishers" {

  class Work {
    +id : UUID
    +title : String
    +type : WorkType
    +composers : String
    +arrangers : String [0..1]
    +instrumentation : String [0..1]
    +grade : String [0..1]
    +durationSec : Integer [0..1]
    +mbWorkId : UUID [0..1]
    +iswc : String [0..1]
  }

  class WorkRelation {
    +type : WorkRelationType
    +position : Integer [0..1]
    +sectionStart : String [0..1]
    +sectionEnd : String [0..1]
    +origin : String
    +confidence : Confidence
  }

  class RecordingWork {
    +confirmed : Boolean
  }

  class Publisher {
    +id : UUID
    +name : String
    +country : String [0..1]
    +website : String [0..1]
    +adapterType : PublisherAdapterType
    +adapterConfigJson : String
    +profileRef : String [0..1]
    +active : Boolean
    +rateLimitPerMin : Integer
    +lastQueriedAt : DateTime [0..1]
  }

  class Publication {
    +id : UUID
    +orderNumber : String [0..1]
    +ismn : String [0..1]
    +title : String
    +instrumentation : String [0..1]
    +grade : String [0..1]
    +durationSec : Integer [0..1]
    +productUrl : String [0..1]
    +fetchedAt : DateTime
  }

  enum WorkType {
    ORIGINAL
    ARRANGEMENT
    MEDLEY
    ADAPTATION
  }

  enum WorkRelationType {
    ARRANGEMENT_OF
    MEDLEY_CONTAINS
    PART_OF
  }

  enum PublisherAdapterType {
    STRUCTURED_DATA
    HTML_SELECTORS
    PLUGIN
    LLM
    CSV_IMPORT
  }

  enum Confidence {
    HIGH
    MEDIUM
    LOW
  }

  enum ReviewStatus {
    OPEN
    ACCEPTED
    REJECTED
    DEFERRED
    OBSOLETE
    AUTO_ACCEPTED
  }
  note bottom of ReviewStatus
    AUTO_ACCEPTED only for Sheet.reviewStatus;
    automatic decisions create no ReviewItem.
  end note
}

' =====================================================================
package "Review" {

  class ReviewItem {
    +id : UUID
    +type : ReviewType
    +subjectType : String
    +subjectId : UUID
    +origin : ReviewOrigin
    +confidence : Confidence
    +evidenceJson : String
    +proposalJson : String
    +suppressionKey : String
    +summaryJson : String
    +status : ReviewStatus
    +note : String [0..1]
    +createdAt : DateTime
    +decidedAt : DateTime [0..1]
  }
  note right of ReviewItem
    Also holds work candidates.
    Unique suppressionKey while
    OPEN, DEFERRED or REJECTED.
    summaryJson: display text of
    subject, current and proposed value.
  end note

  class ReviewCounter {
    +type : ReviewType
    +origin : ReviewOrigin
    +confidence : Confidence
    +status : ReviewStatus
    +value : Long
  }
  note right of ReviewCounter
    Maintained with every insert
    and decision (counts first).
  end note

  enum ReviewType {
    RECORDING_MATCH
    MUSICBRAINZ_SUGGESTION
    IMPORT_TITLE
    IMPORT_REPLACEMENT
    QUALITY_FINDING
    WORK_ASSIGNMENT
    DOWNLOAD_REPLACEMENT
    SHEET_OMR
  }

  enum ReviewOrigin {
    PUBLISHER
    MUSICBRAINZ
    LLM
    FUZZY_MATCH
    QUALITY_ANALYSIS
    IMPORT
    SOURCE
    OMR
  }
}

' =====================================================================
package "Sheet Music" {

  class Sheet {
    +id : UUID
    +type : SheetType
    +instrument : String
    +voice : String [0..1]
    +transposition : Transposition
    +clef : String [0..1]
    +recognitionStatus : RecognitionStatus
    +reviewStatus : ReviewStatus
    +displayMode : DisplayMode
  }
  note right of Sheet
    SCORE  -> page mode
    PART   -> line (system) mode
    Keyboard / accordion parts:
    one system = all braced staves
  end note

  class SheetFile {
    +id : UUID
    +kind : SheetFileKind
    +path : String
    +version : Integer
  }

  class SheetPage {
    +id : UUID
    +pageNumber : Integer
    +width : Float
    +height : Float
    +previewPath : String
  }

  class SheetSystem {
    +id : UUID
    +index : Integer
    +bbox : Rect
    +staffCount : Integer
  }

  class MeasureMapEntry {
    +measureNumber : Integer
    +bbox : Rect
    +startMs : Integer
    +endMs : Integer
    +recognitionConfidence : Float [0..1]
  }

  class SheetAnnotation {
    +id : UUID
    +measureNumber : Integer
    +dataJson : String
  }

  enum SheetType {
    SCORE
    PART
  }

  enum DisplayMode {
    AUTO
    PAGE
    SYSTEM
  }

  enum Transposition {
    C
    B_FLAT
    E_FLAT
    F
    OTHER
  }

  enum SheetFileKind {
    PDF
    IMAGE
    MUSICXML
    MEI
    MIDI
  }

  enum RecognitionStatus {
    NOT_NEEDED
    PENDING
    RUNNING
    RECOGNIZED
    FAILED
  }
}

' =====================================================================
package "Video" {

  class VideoFile {
    +id : UUID
    +path : String
    +container : String
    +videoCodec : String
    +audioCodec : String
    +width : Integer
    +height : Integer
    +durationMs : Integer
    +sizeBytes : Long
    +contentHash : String
    +sourceItemId : String [0..1]
    +thumbnailPath : String
  }
  note right of VideoFile
    Separate media type: its audio is
    never an audio original.
  end note

  class VideoRendition {
    +id : UUID
    +height : Integer
    +bitrateKbps : Integer
    +hlsPath : String
    +lastAccessedAt : DateTime
  }

  class VideoChapter {
    +id : UUID
    +title : String
    +startMs : Integer
    +endMs : Integer
  }
}

