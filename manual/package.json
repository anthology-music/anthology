{
  "name": "@anthology/manual",
  "version": "0.1.0",
  "private": true,
  "description": "User manual of Anthology (VitePress, English and German)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "node scripts/check-pages.mjs && vitepress build",
    "check": "node scripts/check-pages.mjs",
    "check:screenshots": "node scripts/check-screenshots.mjs",
    "test": "node --test scripts/*.test.mjs",
    "walkthrough": "playwright test -c walkthrough/playwright.config.ts",
    "lint": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "prettier": "^3.9.10",
    "vitepress": "^1.6.4",
    "vue": "^3.5.43"
  }
}
