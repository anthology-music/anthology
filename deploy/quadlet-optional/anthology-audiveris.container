# audiveris – AGPL-3.0 (upstream, unmodified) – OPTIONAL
# Copy to ~/.config/containers/systemd/ only if you want sheet-music recognition from PDFs.
[Unit]
Description=Anthology optical music recognition (optional)

[Container]
ContainerName=anthology-audiveris
Pod=anthology.pod
Image=ghcr.io/anthology-music/anthology-audiveris:latest
Volume=anthology-imports.volume:/data/imports:U

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
