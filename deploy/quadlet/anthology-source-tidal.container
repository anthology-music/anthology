# anthology-source-tidal – GPL-3.0-only (streamrip) – OPTIONAL
# Install only if you want the Tidal source. Delete this file to disable it.
[Unit]
Description=Anthology Tidal source (optional)

[Container]
ContainerName=anthology-source-tidal
Pod=anthology.pod
Image=ghcr.io/<organisation>/anthology-source-tidal:latest
Volume=anthology-imports.volume:/data/imports:U

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
