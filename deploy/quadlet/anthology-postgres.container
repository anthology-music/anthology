# PostgreSQL for Anthology
[Unit]
Description=Anthology database

[Container]
ContainerName=anthology-postgres
Pod=anthology.pod
Image=docker.io/library/postgres:18
Environment=POSTGRES_USER=anthology
Environment=POSTGRES_DB=anthology
# Password from the Podman secret (podman secret create anthology-db-password -)
Secret=anthology-db-password,type=mount,target=/run/secrets/anthology-db-password
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/anthology-db-password
# From PostgreSQL 18 on the image keeps its data below /var/lib/postgresql/<major>/docker
Volume=anthology-db.volume:/var/lib/postgresql:U
HealthCmd=pg_isready -U anthology -d anthology
HealthInterval=5s
Notify=healthy

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
