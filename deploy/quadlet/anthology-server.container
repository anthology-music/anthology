# anthology-server – MIT
[Unit]
Description=Anthology server
Requires=anthology-postgres.service
Wants=anthology-tagger.service
After=anthology-postgres.service anthology-tagger.service

[Container]
ContainerName=anthology-server
Pod=anthology.pod
Image=ghcr.io/anthology-music/anthology-server:latest
# The password comes from the Podman secret, not from the URL.
Environment=ANTHOLOGY_DATABASE_URL=postgresql+asyncpg://anthology@localhost:5432/anthology
Secret=anthology-db-password,type=mount,target=/run/secrets/anthology-db-password
Environment=ANTHOLOGY_DATABASE_PASSWORD_FILE=/run/secrets/anthology-db-password
Environment=ANTHOLOGY_TAGGER_URL=http://localhost:8410
# Optional source services (ADR 0017), comma-separated, e.g. http://localhost:8420,http://localhost:8421
Environment=ANTHOLOGY_SOURCE_SERVICES=
# Optional sheet-music recognition (anthology-audiveris.container)
Environment=ANTHOLOGY_OMR_URL=http://localhost:8430
# Metadata lookups: contact for the MusicBrainz User-Agent (your e-mail or URL), optional
# AcoustID key and optional local MusicBrainz mirror (docs/architecture/musicbrainz-mirror.md)
Environment=ANTHOLOGY_MUSICBRAINZ_CONTACT=
Environment=ANTHOLOGY_ACOUSTID_API_KEY=
Environment=ANTHOLOGY_MUSICBRAINZ_URL=
# Raumfeld speakers (docs/install.md): host addresses if multicast does not reach the pod,
# comma-separated, and the URL the speakers fetch music from (e.g. http://192.168.1.10:8400)
Environment=ANTHOLOGY_RAUMFELD_HOSTS=
Environment=ANTHOLOGY_OUTPUT_MEDIA_URL=
# Folders admins may import from, comma-separated (docs/install.md, Importing a collection)
Environment=ANTHOLOGY_IMPORT_ROOTS=/data/imports
Volume=anthology-keys.volume:/data/keys:U
Volume=anthology-library.volume:/data/library:U
Volume=anthology-cache.volume:/data/cache:U
Volume=anthology-imports.volume:/data/imports:U
Volume=anthology-video.volume:/data/video:U

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
