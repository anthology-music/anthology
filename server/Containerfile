# anthology-server – MIT
# Build from the repository root:
#   podman build -t anthology-server -f server/Containerfile .

# Web client: built once, served by the server (one port, one origin).
FROM docker.io/library/node:22-slim AS web

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

WORKDIR /src

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
COPY client ./client
COPY docs/design/tokens.css ./docs/design/tokens.css
RUN pnpm install --frozen-lockfile && pnpm build
# License files of the client's production dependencies (THIRD_PARTY_LICENSES.md, section 8)
COPY tools/licenses/collect-client.mjs ./tools/licenses/collect-client.mjs
RUN node tools/licenses/collect-client.mjs /licenses/client


# FFmpeg with Chromaprint: an own minimal LGPL build (ADR 0020). Chromaprint uses its bundled
# KissFFT (BSD-3-Clause); FFTW3 (GPL) is never used, and FFmpeg is built without --enable-gpl
# and --enable-nonfree. Only the parts Anthology needs are enabled.
FROM docker.io/library/python:3.12-slim AS ffmpeg

ARG FFMPEG_VERSION=8.1.3
ARG FFMPEG_SHA256=7138d28c96d9d3e3af4ee3d8cad72741f8ffb40da90c1112235dea3ecd3178a3
# github.com/FFmpeg/FFmpeg/archive/refs/tags/n<version>.tar.gz (the same release).
ARG FFMPEG_MIRROR_SHA256=09f990289327d3ebfedf4fc15cae3f884a65dab7a5aac7bbb5b01ff83900efd9
ARG CHROMAPRINT_VERSION=1.6.2
ARG CHROMAPRINT_SHA256=d54ada62c16b2db396d3251ec54fc7a58909c163131a1cfcf7fa6407dbc14360

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake curl nasm pkg-config xz-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
# Downloads are retried: a source host that is briefly unreachable must not fail the build
# (the checksums still decide what is used).
ENV CURL_RETRY="--retry 5 --retry-all-errors --retry-delay 10 --connect-timeout 30"
RUN curl -fsSL $CURL_RETRY -o chromaprint.tar.gz \
        "https://github.com/acoustid/chromaprint/releases/download/v${CHROMAPRINT_VERSION}/chromaprint-${CHROMAPRINT_VERSION}.tar.gz" \
    && echo "${CHROMAPRINT_SHA256}  chromaprint.tar.gz" | sha256sum -c - \
    && tar xzf chromaprint.tar.gz \
    && cmake -S "chromaprint-${CHROMAPRINT_VERSION}" -B chromaprint-build \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/ffmpeg \
        -DBUILD_SHARED_LIBS=OFF -DBUILD_TOOLS=OFF -DBUILD_TESTS=OFF -DFFT_LIB=kissfft \
    && cmake --build chromaprint-build -j"$(nproc)" \
    && cmake --install chromaprint-build

# The release from ffmpeg.org, or the same release from the project's GitHub mirror when
# ffmpeg.org cannot be reached (each archive with its own checksum).
RUN mkdir ffmpeg-src \
    && ( (curl -fsSL --retry 2 --retry-all-errors --retry-delay 5 --connect-timeout 20 \
            -o ffmpeg.tar.xz "https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz" \
          && echo "${FFMPEG_SHA256}  ffmpeg.tar.xz" | sha256sum -c - \
          && tar xJf ffmpeg.tar.xz -C ffmpeg-src --strip-components=1) \
      || (echo "ffmpeg.org failed; using the GitHub mirror" \
          && rm -rf ffmpeg-src && mkdir ffmpeg-src \
          && curl -fsSL $CURL_RETRY -o ffmpeg.tar.gz \
            "https://github.com/FFmpeg/FFmpeg/archive/refs/tags/n${FFMPEG_VERSION}.tar.gz" \
          && echo "${FFMPEG_MIRROR_SHA256}  ffmpeg.tar.gz" | sha256sum -c - \
          && tar xzf ffmpeg.tar.gz -C ffmpeg-src --strip-components=1) ) \
    && cd ffmpeg-src \
    && PKG_CONFIG_PATH=/opt/ffmpeg/lib/pkgconfig ./configure \
        --prefix=/opt/ffmpeg \
        --pkg-config-flags=--static \
        --extra-libs="-lstdc++ -lm" \
        --extra-ldflags="-static-libstdc++ -static-libgcc" \
        --disable-everything --disable-autodetect --disable-doc --disable-network \
        --disable-ffplay --enable-ffmpeg --enable-ffprobe \
        --enable-swresample --enable-chromaprint \
        --enable-protocol=file,pipe \
        --enable-demuxer=flac,wav,aiff,mov,mp3,aac,ogg,matroska \
        --enable-parser=flac,mpegaudio,aac,opus,vorbis \
        --enable-decoder=flac,alac,mp3,mp3float,aac,opus,vorbis,pcm_s16le,pcm_s24le,pcm_s32le,pcm_s16be,pcm_s24be,pcm_s32be,pcm_f32le,pcm_f32be,pcm_u8 \
        --enable-encoder=aac,alac,flac,pcm_s16le,pcm_s24le,pcm_s32le,pcm_f32le \
        --enable-muxer=chromaprint,hash,ipod,mp4,flac,wav,null,pcm_f32le,pcm_s32le \
        --enable-filter=aresample,aformat,anull,atrim \
    && make -j"$(nproc)" \
    && make install \
    && /opt/ffmpeg/bin/ffmpeg -hide_banner -buildconf | grep -q -- --enable-chromaprint \
    && /opt/ffmpeg/bin/ffmpeg -hide_banner -muxers | grep -q " hash " \
    && /opt/ffmpeg/bin/ffmpeg -hide_banner -muxers | grep -q " f32le " \
    && ! /opt/ffmpeg/bin/ffmpeg -hide_banner -buildconf | grep -E -- "--enable-(gpl|nonfree)"


# Only ffmpeg and ffprobe: CI runs the server tests with this build (.github/actions/ffmpeg).
# They need at most GLIBC 2.38 and run on the ubuntu-24.04 runners (2.39).
FROM scratch AS ffmpeg-bin
COPY --from=ffmpeg /opt/ffmpeg/bin/ffmpeg /opt/ffmpeg/bin/ffprobe /


FROM docker.io/library/python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /src

# Dependencies first for layer caching
COPY server/pyproject.toml server/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY server/anthology ./anthology
RUN uv sync --frozen --no-dev --no-editable

# License files of the server's production dependencies (THIRD_PARTY_LICENSES.md, section 8)
COPY tools/licenses/generate.py /repo/tools/licenses/generate.py
COPY server/uv.lock /repo/server/uv.lock
RUN /app/.venv/bin/python /repo/tools/licenses/generate.py --server-texts /licenses/server


FROM docker.io/library/python:3.12-slim

LABEL org.opencontainers.image.title="anthology-server" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/anthology-music/anthology"

RUN groupadd --gid 1000 anthology \
    && useradd --uid 1000 --gid anthology --home-dir /app --no-create-home anthology \
    && mkdir -p /data/keys /data/library /data/cache /data/imports /data/video \
    && chown -R anthology:anthology /data

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY --from=ffmpeg /opt/ffmpeg/bin/ffmpeg /opt/ffmpeg/bin/ffprobe /usr/local/bin/
RUN ffmpeg -hide_banner -version > /dev/null && ffprobe -hide_banner -version > /dev/null
COPY server/alembic.ini ./alembic.ini
COPY server/migrations ./migrations
COPY server/entrypoint.sh ./entrypoint.sh
COPY --from=web /src/client/dist/spa ./web
# Licenses: Anthology's, the list of third-party components and their license files
COPY LICENSE THIRD_PARTY_LICENSES.md ./licenses/
COPY --from=builder /licenses/server ./licenses/server
COPY --from=web /licenses/client ./licenses/client

ENV PATH=/app/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    ANTHOLOGY_DATA_DIR=/data \
    ANTHOLOGY_MIGRATIONS_DIR=/app/migrations \
    ANTHOLOGY_WEB_DIR=/app/web

# Build information (change first-release): last, so that it does not invalidate the layers above.
ARG ANTHOLOGY_BUILD_VERSION=""
ARG ANTHOLOGY_BUILD_COMMIT=""
ENV ANTHOLOGY_BUILD_VERSION=$ANTHOLOGY_BUILD_VERSION \
    ANTHOLOGY_BUILD_COMMIT=$ANTHOLOGY_BUILD_COMMIT \
    ANTHOLOGY_LICENSES_DIR=/app/licenses

USER anthology
EXPOSE 8400

ENTRYPOINT ["/app/entrypoint.sh"]
